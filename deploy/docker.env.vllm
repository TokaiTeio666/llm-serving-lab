# Run the gateway against a real vLLM server.
#
#   docker compose --env-file deploy/docker.env.vllm -f deploy/docker-compose.yml \
#     --profile vllm --profile observability up -d
#
# The model service keeps its fault injection in front of vLLM, so the
# gateway's breaker / fallback paths stay testable against a real engine.

MODEL_BACKEND=vllm
VLLM_A_URL=http://vllm:8000
VLLM_B_URL=http://vllm:8000
VLLM_A_MODEL=big-model
VLLM_B_MODEL=small-model
VLLM_SERVED_NAME=qwen2.5-1.5b
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=64
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_TIMEOUT_S=300

# Point at a mirror when huggingface.co is unreachable.
HF_ENDPOINT=https://hf-mirror.com

# Same image overrides as docker.env, plus host ports.
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v3.5.0
GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana:12.1.0
VLLM_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:latest

GATEWAY_PORT=8080
MODEL_A_PORT=8101
MODEL_B_PORT=8102
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
VLLM_PORT=8001

