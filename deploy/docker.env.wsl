# Run the stack against a vLLM server hosted in WSL2 (GPU passthrough).
#
#   docker compose --env-file deploy/docker.env.wsl -f deploy/docker-compose.yml \
#     --profile observability up -d
#
# Every compose invocation that touches model-a/model-b has to use THIS file.
# `docker compose run` recreates dependencies whose config differs, so mixing
# env files silently flips the backend back to the mock.

MODEL_BACKEND=vllm
VLLM_A_URL=http://host.docker.internal:8001
VLLM_B_URL=http://host.docker.internal:8002
VLLM_A_MODEL=big-model
VLLM_B_MODEL=small-model
VLLM_TIMEOUT_S=300

# Image overrides + host ports (same as docker.env).
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v3.5.0
GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana:12.1.0

GATEWAY_PORT=8080
MODEL_A_PORT=8101
MODEL_B_PORT=8102
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300

