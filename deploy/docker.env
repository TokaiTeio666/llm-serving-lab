# Image overrides for networks where docker.io is unreachable.
# Use with:
#   docker compose --env-file deploy/docker.env -f deploy/docker-compose.yml up -d
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v3.5.0
GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana:12.1.0

# Host ports. Change these if something already listens on them.
GATEWAY_PORT=8080
MODEL_A_PORT=8101
MODEL_B_PORT=8102
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300

