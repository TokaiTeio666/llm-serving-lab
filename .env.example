# ---- API gateway ----
API_HOST=0.0.0.0
API_PORT=8000

# Upstream model services (primary, then fallback)
MODEL_A_URL=http://127.0.0.1:8101
MODEL_B_URL=http://127.0.0.1:8102
API_PRIMARY_MODEL=llm-fast
API_FALLBACK_MODEL=llm-lite

# Upstream timeouts (seconds). total must exceed connect+read headroom.
UPSTREAM_CONNECT_TIMEOUT=2.0
UPSTREAM_READ_TIMEOUT=30.0
UPSTREAM_TOTAL_TIMEOUT=60.0

# Retry policy for non-streaming requests only
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY=0.05
UPSTREAM_RETRY_MAX_DELAY=1.0

# Admission control
MAX_INFLIGHT=64
MAX_QUEUE=256
QUEUE_TIMEOUT_S=5.0

# Per-tenant rate limit (token bucket)
RATE_LIMIT_RPM=120
RATE_LIMIT_TPM=20000
RATE_LIMIT_BURST=30

# Circuit breaker
BREAKER_FAIL_THRESHOLD=5
BREAKER_OPEN_SECONDS=10.0
BREAKER_HALF_OPEN_PROBES=2

# Cache
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=512
CACHE_TTL_S=300
CACHE_MAX_TOKENS=512

# ---- Model service ----
MODEL_NAME=llm-fast
# mock = simulated engine (no GPU, deterministic, fault injection).
# vllm = proxy in front of a real vLLM OpenAI-compatible server.
MODEL_BACKEND=mock
MODEL_TTFT_MS=120
MODEL_TOKENS_PER_SEC=90
MODEL_PREEMPTION_RATIO=0.0
MODEL_MAX_OUTPUT_TOKENS=256
MODEL_FAULT_RATE=0.0
MODEL_MAX_CONCURRENCY=64
MODEL_MAX_QUEUE=128
MODEL_QUEUE_TIMEOUT_S=10
MODEL_PORT=8101

# ---- vLLM backend ----
VLLM_URL=http://127.0.0.1:8001
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_API_KEY=
VLLM_TIMEOUT_S=300
VLLM_CONNECT_TIMEOUT_S=5
VLLM_MAX_MODEL_LEN=4096

# ---- Load harness ----
LOAD_BASE_URL=http://127.0.0.1:8000
LOAD_DURATION_S=30
LOAD_CONCURRENCY=16
LOAD_WARMUP_S=5
LOAD_STREAM=true
LOAD_OUTPUT=reports/load-latest.json

LOG_LEVEL=INFO
LOG_JSON=true
